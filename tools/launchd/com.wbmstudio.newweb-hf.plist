<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.wbmstudio.newweb-hf</string>
  <key>UserName</key><string>mark</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/libexec/extdrive-exec</string>
    <string>/Users/mark/newweb/venv/bin/python</string><string>-m</string><string>newweb.hf</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/mark/newweb</string>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>/Users/mark</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/mark/newweb/logs/hf.log</string>
  <key>StandardErrorPath</key><string>/Users/mark/newweb/logs/hf.log</string>
</dict></plist>
